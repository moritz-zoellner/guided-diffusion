#!/bin/sh
#SBATCH -J snr_k32_bugfix_v1
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=32G
#SBATCH --qos=normal
#SBATCH -t 24:00:00
#SBATCH -o slurm-%j.out

module load conda
conda activate guided_diffusion

export MUJOCO_GL=egl
export EGL_DEVICE_ID=0
export CUDA_VISIBLE_DEVICES=0
unset DISPLAY

cd ~/src/guided-diffusion

CKPT_PATH=/scratch/gilbreth/zoellner/diffusion_runs/can_mh_lowdim/20260209180642/models/model_epoch_2000.pth
BASE_DIR=/scratch/gilbreth/zoellner/diffusion_rollouts/can_rollouts/comparison/20260407_210830_v1_s1_50
OUT_ROOT=${BASE_DIR}/snr_k32
INIT_NAME=n16h300r60g1bYfYv1
INIT_STATE_JSON=outputs/can_rollouts/snr/${INIT_NAME}/init_state.json

mkdir -p "${OUT_ROOT}"
echo "[start] SNR k32 loop seeds=1..50 out_root=${OUT_ROOT}"

for SEED in $(seq 1 50); do
  RUN_NAME=${INIT_NAME}_seed${SEED}
  FINAL_DIR=${OUT_ROOT}/${RUN_NAME}

  echo "[seed-start] seed=${SEED} run_name=${RUN_NAME}"
  rm -rf "${FINAL_DIR}"

  /home/zoellner/.conda/envs/guided_diffusion/bin/python -u experiments/sample-and-rank.py \
    --num_samples 32 \
    --Ta 8 \
    --horizon 300 \
    --n_rollouts 1 \
    --n_step_rollout_video 1 \
    --record_video y \
    --video_skip 1 \
    --camera_names frontview \
    --output_path "${OUT_ROOT}" \
    --name "${RUN_NAME}" \
    --ckpt_path "${CKPT_PATH}" \
    --world_model_run_path models/dynamics/baseline_mlp \
    --guidance_rollout_steps 8 \
    --seed "${SEED}" \
    --init_state_json "${INIT_STATE_JSON}"

  if [ ! -d "${FINAL_DIR}" ]; then
    echo "[error] missing expected output dir: ${FINAL_DIR}"
    exit 1
  fi
  echo "[seed-done] seed=${SEED} final_dir=${FINAL_DIR}"
done

echo "[done] all seeds complete under ${OUT_ROOT}"
