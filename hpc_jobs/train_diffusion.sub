#!/bin/sh
#SBATCH -J diffusion_policy
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=32G
#SBATCH --qos=normal
#SBATCH -t 24:00:00
#SBATCH -o slurm-%j.out

module load conda
#conda activate /scratch/gilbreth/zoellner/conda/envs/guided_diffusion
conda activate guided_diffusion

export MUJOCO_GL=egl
export EGL_DEVICE_ID=0
export CUDA_VISIBLE_DEVICES=0
unset DISPLAY

# ============================================================================
# CONFIG SELECTION: Uncomment ONE of the following to choose which config to use
# ============================================================================
#CONFIG_NAME=diffusion_policy.json           # Original CAN config
CONFIG_NAME=diffusion_policy_toy_squares.json  # Toy Squares (TouchCube) DP config
# ============================================================================

echo "Starting diffusion policy training via SLURM"
echo "Using config: $CONFIG_NAME"
cd /home/zoellner/src/guided-diffusion
start_time=$(date +%s)
#python robomimic/robomimic/scripts/train.py --config configs/$CONFIG_NAME --name can_mh_lowdim --resume 
python robomimic/robomimic/scripts/train.py --config configs/$CONFIG_NAME
end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Finished training? elapsed_seconds=${elapsed}"
