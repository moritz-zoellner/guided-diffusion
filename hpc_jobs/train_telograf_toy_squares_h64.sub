#!/bin/bash
#SBATCH -J telograf_toy_h64
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=64G
#SBATCH --qos=normal
#SBATCH -t 24:00:00
#SBATCH -o /scratch/gilbreth/zoellner/guided-diffusion/outputs/telograf/logs/%x-%j.out

set -euo pipefail

module load conda

# Override at submission time if your cluster env / path differs:
#   CONDA_ENV=guided_diffusion sbatch hpc_jobs/train_telograf_toy_squares_h64.sub
#   DATASET=/path/to/data.hdf5 sbatch hpc_jobs/train_telograf_toy_squares_h64.sub
CONDA_ENV=${CONDA_ENV:-guided_diffusion}
REPO_ROOT=${REPO_ROOT:-/home/zoellner/src/guided-diffusion}
SCRATCH_ROOT=${SCRATCH_ROOT:-/scratch/gilbreth/zoellner/guided-diffusion}
DATASET=${DATASET:-${SCRATCH_ROOT}/data/toy_squares/train/data.hdf5}
OUTPUT_ROOT=${OUTPUT_ROOT:-${SCRATCH_ROOT}/outputs/telograf/toy_squares}
export DATASET OUTPUT_ROOT SCRATCH_ROOT REPO_ROOT

conda activate "${CONDA_ENV}"

mkdir -p "${OUTPUT_ROOT}/datasets" "${OUTPUT_ROOT}/runs" "${OUTPUT_ROOT}/diagnostics" "${SCRATCH_ROOT}/outputs/telograf/logs" "${SCRATCH_ROOT}/outputs/telograf/.cache/matplotlib" "${SCRATCH_ROOT}/outputs/telograf/.cache/fontconfig" "${SCRATCH_ROOT}/outputs/telograf/.cache/huggingface"

export MPLCONFIGDIR=${MPLCONFIGDIR:-${SCRATCH_ROOT}/outputs/telograf/.cache/matplotlib}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-${SCRATCH_ROOT}/outputs/telograf/.cache}
export HF_HOME=${HF_HOME:-${SCRATCH_ROOT}/outputs/telograf/.cache/huggingface}
export TRANSFORMERS_CACHE=${TRANSFORMERS_CACHE:-${HF_HOME}/hub}
export CUDA_DEVICE_ORDER=${CUDA_DEVICE_ORDER:-PCI_BUS_ID}
unset DISPLAY

cd "${REPO_ROOT}"
start_time=$(date +%s)

echo "Starting TeLoGraF Toy Squares H=64 single-behavior pipeline"
echo "dataset=${DATASET}"
echo "output_root=${OUTPUT_ROOT}"
echo "conda_env=${CONDA_ENV}"

test -f "${DATASET}"
python -u - <<'PY'
import os
from pathlib import Path
import sys

import h5py

dataset = Path(os.environ["DATASET"])
with h5py.File(dataset, "r") as h5:
    n = len(h5["data"])
    if n != 10000:
        raise RuntimeError(f"Expected 10000 Toy Squares demos in {dataset}, found {n}")
    train_n = len(h5["mask"]["train"]) if "mask" in h5 and "train" in h5["mask"] else 0
    valid_n = len(h5["mask"]["valid"]) if "mask" in h5 and "valid" in h5["mask"] else 0
    print(f"Toy Squares dataset OK: demos={n} train={train_n} valid={valid_n}")

repo = Path.cwd()
sys.path.insert(0, str(repo / "TeLoGraF" / "code"))
from z_diffuser import GaussianFlow, TemporalUnet

print(f"TeLoGraF backend OK: {GaussianFlow.__name__}, {TemporalUnet.__name__}")
PY

python -u -m telograf_toy_squares.run_telograf_toy_pipeline \
  --dataset "${DATASET}" \
  --policy h64 \
  --output-root "${OUTPUT_ROOT}" \
  --name h64_full_10k \
  --skip-diagnostics \
  --epochs 200 \
  --batch-size 256 \
  --lr 3e-4 \
  --n-timesteps 100 \
  --dim 64 \
  --dim-mults 1 2 4 8 \
  --num-workers 4 \
  --eval-samples 512 \
  --save-every 25

end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Finished TeLoGraF Toy Squares H=64. elapsed_seconds=${elapsed}"
