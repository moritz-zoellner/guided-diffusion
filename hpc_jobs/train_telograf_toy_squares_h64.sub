#!/bin/bash
#SBATCH -J telograf_toy_h64
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=64G
#SBATCH --qos=normal
#SBATCH -t 24:00:00
#SBATCH -o slurm-%j.out

set -euo pipefail

module load conda

# Override at submission time if your cluster env / path differs:
#   CONDA_ENV=guided_diffusion sbatch hpc_jobs/train_telograf_toy_squares_h64.sub
#   DATASET=/path/to/data.hdf5 sbatch hpc_jobs/train_telograf_toy_squares_h64.sub
CONDA_ENV=${CONDA_ENV:-calvin}
REPO_ROOT=${REPO_ROOT:-/home/zoellner/src/guided-diffusion}
DATASET=${DATASET:-${REPO_ROOT}/outputs/telograf/toy_squares/raw/full_10k/data.hdf5}
OUTPUT_ROOT=${OUTPUT_ROOT:-${REPO_ROOT}/outputs/telograf/toy_squares}

conda activate "${CONDA_ENV}"

export MPLCONFIGDIR=${MPLCONFIGDIR:-/tmp/matplotlib}
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}
unset DISPLAY

cd "${REPO_ROOT}"
start_time=$(date +%s)

echo "Starting TeLoGraF Toy Squares H=64 single-behavior pipeline"
echo "dataset=${DATASET}"
echo "output_root=${OUTPUT_ROOT}"
echo "conda_env=${CONDA_ENV}"

python -u -m telograf_toy_squares.run_telograf_toy_pipeline \
  --dataset "${DATASET}" \
  --policy h64 \
  --output-root "${OUTPUT_ROOT}" \
  --name h64_full_10k \
  --skip-diagnostics \
  --epochs 200 \
  --batch-size 256 \
  --lr 3e-4 \
  --n-timesteps 100 \
  --dim 64 \
  --dim-mults 1 2 4 8 \
  --num-workers 4 \
  --eval-samples 512 \
  --save-every 25

end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Finished TeLoGraF Toy Squares H=64. elapsed_seconds=${elapsed}"
