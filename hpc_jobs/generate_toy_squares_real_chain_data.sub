#!/bin/bash
#SBATCH -J toy_real_chain_data
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=128G
#SBATCH --qos=normal
#SBATCH -t 12:00:00
#SBATCH -o /scratch/gilbreth/zoellner/guided-diffusion/outputs/telograf/logs/%x-%j.out

set -euo pipefail

module load conda

CONDA_ENV=${CONDA_ENV:-guided_diffusion}
REPO_ROOT=${REPO_ROOT:-/home/zoellner/src/guided-diffusion}
SCRATCH_ROOT=${SCRATCH_ROOT:-/scratch/gilbreth/zoellner/guided-diffusion}
OUT_DIR=${OUT_DIR:-${SCRATCH_ROOT}/outputs/telograf/toy_squares/data/real_chains_len5_10k}
N_ROLLOUTS=${N_ROLLOUTS:-10000}
SEED=${SEED:-23}
CURVE_STRIDE=${CURVE_STRIDE:-3}
MAX_STEPS_PER_GOAL=${MAX_STEPS_PER_GOAL:-30}

conda activate "${CONDA_ENV}"

mkdir -p "${OUT_DIR}" "${SCRATCH_ROOT}/outputs/telograf/logs" "${SCRATCH_ROOT}/outputs/telograf/.cache/matplotlib" "${SCRATCH_ROOT}/outputs/telograf/.cache/fontconfig" "${SCRATCH_ROOT}/outputs/telograf/.cache/huggingface"
export MPLCONFIGDIR=${MPLCONFIGDIR:-${SCRATCH_ROOT}/outputs/telograf/.cache/matplotlib}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-${SCRATCH_ROOT}/outputs/telograf/.cache}
export HF_HOME=${HF_HOME:-${SCRATCH_ROOT}/outputs/telograf/.cache/huggingface}
export TRANSFORMERS_CACHE=${TRANSFORMERS_CACHE:-${HF_HOME}/hub}
unset DISPLAY

cd "${REPO_ROOT}"
start_time=$(date +%s)

echo "Starting ToySquares length-5 real-env TeLoGraF dataset generation"
echo "out_dir=${OUT_DIR}"
echo "n_rollouts=${N_ROLLOUTS}"
echo "curve_stride=${CURVE_STRIDE}"
echo "max_steps_per_goal=${MAX_STEPS_PER_GOAL}"
echo "conda_env=${CONDA_ENV}"

python -u telograf_toy_squares/generate_toy_squares_real_chain_data.py \
  --output-dir "${OUT_DIR}" \
  --n-rollouts "${N_ROLLOUTS}" \
  --chain-length 5 \
  --horizons 128 196 \
  --seed "${SEED}" \
  --policy-step-stride "${CURVE_STRIDE}" \
  --max-steps-per-goal "${MAX_STEPS_PER_GOAL}" \
  --preview-videos 4

end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Finished real-chain dataset generation. elapsed_seconds=${elapsed}"
