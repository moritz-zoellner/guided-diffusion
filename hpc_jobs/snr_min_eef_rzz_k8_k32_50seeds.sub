#!/bin/sh
#SBATCH -J snr_min_eef_rzz
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=32G
#SBATCH --qos=normal
#SBATCH -t 24:00:00
#SBATCH -o slurm-%j.out

set -euo pipefail

module load conda
conda activate guided_diffusion

export MUJOCO_GL=egl
export EGL_DEVICE_ID=0
export CUDA_VISIBLE_DEVICES=0
unset DISPLAY

cd ~/src/guided-diffusion

CKPT_PATH=/scratch/gilbreth/zoellner/diffusion_runs/can_mh_lowdim/20260209180642/models/model_epoch_2000.pth
BASE_DIR=/scratch/gilbreth/zoellner/diffusion_rollouts/can_rollouts/comparison/min_eef_rzz_guidance
INIT_NAME=n16h300r60g1bYfYv1
INIT_STATE_JSON=outputs/can_rollouts/snr/${INIT_NAME}/init_state.json
WORLD_MODEL_RUN_PATH=models/dynamics/baseline_mlp

mkdir -p "${BASE_DIR}"
echo "[start] min_eef_rzz_guidance seeds=1..50 methods=snr_k8,snr_k32 out_root=${BASE_DIR}"

for NUM_SAMPLES in 8 32; do
  METHOD_NAME=snr_k${NUM_SAMPLES}
  METHOD_DIR=${BASE_DIR}/${METHOD_NAME}
  mkdir -p "${METHOD_DIR}"
  echo "[method-start] ${METHOD_NAME} -> ${METHOD_DIR}"

  for SEED in $(seq 1 50); do
    RUN_NAME=${INIT_NAME}_seed${SEED}
    FINAL_DIR=${METHOD_DIR}/${RUN_NAME}

    echo "[seed-start] method=${METHOD_NAME} seed=${SEED} run_name=${RUN_NAME}"
    rm -rf "${FINAL_DIR}"

    /home/zoellner/.conda/envs/guided_diffusion/bin/python -u experiments/sample-and-rank.py \
      --num_samples "${NUM_SAMPLES}" \
      --Ta 8 \
      --horizon 300 \
      --n_rollouts 1 \
      --n_step_rollout_video 1 \
      --record_video y \
      --video_skip 1 \
      --camera_names frontview \
      --output_path "${METHOD_DIR}" \
      --name "${RUN_NAME}" \
      --ckpt_path "${CKPT_PATH}" \
      --world_model_run_path "${WORLD_MODEL_RUN_PATH}" \
      --guidance_rollout_steps 8 \
      --guidance_objective min_eef_rzz \
      --seed "${SEED}" \
      --init_state_json "${INIT_STATE_JSON}"

    if [ ! -d "${FINAL_DIR}" ]; then
      echo "[error] missing expected output dir: ${FINAL_DIR}"
      exit 1
    fi
    echo "[seed-done] method=${METHOD_NAME} seed=${SEED} final_dir=${FINAL_DIR}"
  done

done

echo "[done] all methods complete under ${BASE_DIR}"
