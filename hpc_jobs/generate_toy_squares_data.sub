#!/bin/sh
#SBATCH -J toy_squares_data
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=128G
#SBATCH --qos=normal
#SBATCH -t 08:00:00
#SBATCH -o slurm-%j.out

module load conda
conda activate guided_diffusion

cd /home/zoellner/src/guided-diffusion
start_time=$(date +%s)

echo "Starting toy_squares dataset generation via SLURM"
bash toy_squares/generate_data.sh

end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Finished dataset generation. elapsed_seconds=${elapsed}"
