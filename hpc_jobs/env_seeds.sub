#!/bin/sh
#SBATCH -J env_seeds_baseDP
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=32G
#SBATCH --qos=normal
#SBATCH -t 1:00:00
#SBATCH -o slurm-%j.out

module load conda
#conda activate /scratch/gilbreth/zoellner/conda/envs/guided_diffusion
conda activate guided_diffusion

export MUJOCO_GL=egl
export EGL_DEVICE_ID=0
export CUDA_VISIBLE_DEVICES=0
unset DISPLAY

CKPT_PATH=/scratch/gilbreth/zoellner/diffusion_runs/can_mh_lowdim/20260209180642/models/model_epoch_2000.pth
OUTPUT_PATH=/scratch/gilbreth/zoellner/diffusion_rollouts/can_rollouts/potential_diffusion_seeds

echo "Starting env-seed sweep via SLURM"
cd ~/src/guided-diffusion
start_time=$(date +%s)

mkdir -p "${OUTPUT_PATH}"

next_run_name() {
  idx=1
  while [ -e "${OUTPUT_PATH}/n4_${idx}" ]; do
    idx=$((idx + 1))
  done
  echo "n4_${idx}"
}

for run_i in 1 2 3; do
  RUN_NAME=$(next_run_name)
  echo "Launching ${RUN_NAME} (batch ${run_i}/3)"

  python -u experiments/rollout_base_policy.py \
    --n_rollouts 4 \
    --output_path "${OUTPUT_PATH}" \
    --ckpt_path "${CKPT_PATH}" \
    --n_step_rollout_video 1 \
    --horizon 300 \
    --name "${RUN_NAME}" \
    --fix_init_state y

done

end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Finished env-seed sweep. elapsed_seconds=${elapsed}"
