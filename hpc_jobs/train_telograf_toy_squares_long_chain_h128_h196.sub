#!/bin/bash
#SBATCH -J telograf_toy_chain
#SBATCH -A rpaleja
#SBATCH -p a100-40gb
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=96G
#SBATCH --qos=normal
#SBATCH -t 48:00:00
#SBATCH -o /scratch/gilbreth/zoellner/guided-diffusion/outputs/telograf/logs/%x-%j.out

set -euo pipefail

module load conda

CONDA_ENV=${CONDA_ENV:-guided_diffusion}
REPO_ROOT=${REPO_ROOT:-/home/zoellner/src/guided-diffusion}
SCRATCH_ROOT=${SCRATCH_ROOT:-/scratch/gilbreth/zoellner/guided-diffusion}
DATA_DIR=${DATA_DIR:-${SCRATCH_ROOT}/outputs/telograf/toy_squares/data/long_chains_len5_10k}
OUTPUT_ROOT=${OUTPUT_ROOT:-${SCRATCH_ROOT}/outputs/telograf/toy_squares/runs}
EPOCHS=${EPOCHS:-200}
BATCH_SIZE_H128=${BATCH_SIZE_H128:-192}
BATCH_SIZE_H196=${BATCH_SIZE_H196:-128}

conda activate "${CONDA_ENV}"

mkdir -p "${OUTPUT_ROOT}" "${SCRATCH_ROOT}/outputs/telograf/logs" "${SCRATCH_ROOT}/outputs/telograf/.cache/matplotlib" "${SCRATCH_ROOT}/outputs/telograf/.cache/fontconfig" "${SCRATCH_ROOT}/outputs/telograf/.cache/huggingface"
export MPLCONFIGDIR=${MPLCONFIGDIR:-${SCRATCH_ROOT}/outputs/telograf/.cache/matplotlib}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-${SCRATCH_ROOT}/outputs/telograf/.cache}
export HF_HOME=${HF_HOME:-${SCRATCH_ROOT}/outputs/telograf/.cache/huggingface}
export TRANSFORMERS_CACHE=${TRANSFORMERS_CACHE:-${HF_HOME}/hub}
export CUDA_DEVICE_ORDER=${CUDA_DEVICE_ORDER:-PCI_BUS_ID}
unset DISPLAY

cd "${REPO_ROOT}"
start_time=$(date +%s)

echo "Starting TeLoGraF ToySquares long-chain training"
echo "data_dir=${DATA_DIR}"
echo "output_root=${OUTPUT_ROOT}"
echo "epochs=${EPOCHS}"
echo "conda_env=${CONDA_ENV}"

test -f "${DATA_DIR}/data_h128.npz"
test -f "${DATA_DIR}/data_h196.npz"

python -u telograf_toy_squares/train_telograf_toy_squares.py \
  --data "${DATA_DIR}/data_h128.npz" \
  --output-root "${OUTPUT_ROOT}" \
  --name toy_squares_long_chain_len5_h128_telograf \
  --epochs "${EPOCHS}" \
  --batch-size "${BATCH_SIZE_H128}" \
  --lr 3e-4 \
  --n-timesteps 100 \
  --dim 64 \
  --dim-mults 1 2 4 8 \
  --num-workers 4 \
  --eval-samples 512 \
  --save-every 25 \
  --require-telograf-backend

python -u telograf_toy_squares/train_telograf_toy_squares.py \
  --data "${DATA_DIR}/data_h196.npz" \
  --output-root "${OUTPUT_ROOT}" \
  --name toy_squares_long_chain_len5_h196_telograf \
  --epochs "${EPOCHS}" \
  --batch-size "${BATCH_SIZE_H196}" \
  --lr 3e-4 \
  --n-timesteps 100 \
  --dim 64 \
  --dim-mults 1 2 4 \
  --num-workers 4 \
  --eval-samples 512 \
  --save-every 25 \
  --require-telograf-backend

end_time=$(date +%s)
elapsed=$((end_time - start_time))
echo "Finished TeLoGraF ToySquares long-chain training. elapsed_seconds=${elapsed}"
